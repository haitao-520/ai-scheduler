<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shifts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg2"
    android:padding="4dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_shifts_today"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/huangyou"
        android:gravity="center_vertical|start"
        android:paddingLeft="6dp"
        android:textColor="#1F5FBF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="今天" />

    <TextView
        android:id="@+id/widget_shifts_tomorrow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/huangyou"
        android:gravity="center_vertical|start"
        android:paddingLeft="6dp"
        android:textColor="#D35400"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="明天" />
</LinearLayout>
