<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ws4_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg2"
    android:padding="4dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ws4_today_label"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="@font/huangyou"
            android:gravity="center_vertical|start"
            android:paddingLeft="6dp"
            android:textColor="#2C3E50"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="今天" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ws4_today0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/huangyou"
                android:gravity="center_vertical|start"
                android:paddingLeft="4dp"
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ws4_today1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/huangyou"
                android:gravity="center_vertical|start"
                android:paddingLeft="4dp"
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ws4_tomorrow_label"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="@font/huangyou"
            android:gravity="center_vertical|start"
            android:paddingLeft="6dp"
            android:textColor="#E6A23C"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="明天" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ws4_tomorrow0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/huangyou"
                android:gravity="center_vertical|start"
                android:paddingLeft="4dp"
                android:textColor="#E6A23C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ws4_tomorrow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/huangyou"
                android:gravity="center_vertical|start"
                android:paddingLeft="4dp"
                android:textColor="#E6A23C"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
